# Claves para la delegación de I/O del harness.
#
# Se copia como `.env` en la raíz del proyecto. El instalador agrega `.env`
# al .gitignore — verificá que esté antes del primer commit.
#
# NUNCA commitear el .env real. NUNCA poner una clave en harness.config.yml.

# Google AI Studio -> https://aistudio.google.com -> Get API key
# Es la que usa el worker por defecto (gemini-2.5-flash).
GEMINI_API_KEY=

# Solo hace falta si ponés un modelo claude-* como worker en
# delegacion.worker_read o delegacion.worker_write.
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
